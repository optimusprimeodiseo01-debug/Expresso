# ============================================================
          # DINAMICA PERSISTENTE
          # ============================================================
          #
          # .gauss_previous NO se utiliza.
          #
          # Los runners de GitHub Actions son efimeros.
          # El estado historico se recupera desde el artifact
          # "gauss-history" generado por ejecuciones anteriores.
          #
          # ============================================================

          HISTORY_DIR="$RUNNER_TEMP/gauss-history"
          HISTORY_FILE="$HISTORY_DIR/gauss-history.json"
          HISTORY_ZIP="$RUNNER_TEMP/gauss-history.zip"

          mkdir -p "$HISTORY_DIR"

          PREVIOUS_GAUSS=""
          HISTORY_SOURCE="NONE"

          # ------------------------------------------------------------
          # RECUPERAR ULTIMO HISTORIAL
          # ------------------------------------------------------------

          ARTIFACT_URL=$(gh api \
            "repos/${GITHUB_REPOSITORY}/actions/artifacts?name=gauss-history&per_page=1" \
            --jq '
              .artifacts
              | map(select(.expired == false))
              | .[0].archive_download_url // empty
            ')

          if [ -n "$ARTIFACT_URL" ]; then
            echo "[HISTORIAL]"
            echo "Artifact encontrado"

            if gh api "$ARTIFACT_URL" > "$HISTORY_ZIP"; then

              if unzip -oq "$HISTORY_ZIP" \
                  -d "$HISTORY_DIR" >/dev/null 2>&1; then

                if [ -s "$HISTORY_FILE" ] &&
                   jq empty "$HISTORY_FILE" >/dev/null 2>&1; then

                  PREVIOUS_GAUSS=$(jq -r '
                    .entries[-1].gauss // empty
                  ' "$HISTORY_FILE")

                  HISTORY_SOURCE="ARTIFACT"

                fi
              fi
            fi
          fi

          # ------------------------------------------------------------
          # INICIALIZAR HISTORIAL SI NO EXISTE
          # ------------------------------------------------------------

          if [ ! -s "$HISTORY_FILE" ]; then
            cat > "$HISTORY_FILE" <<'EOF'
          {
            "schema": 1,
            "entries": []
          }
          EOF
          fi

          # ------------------------------------------------------------
          # CALCULAR DINAMICA
          # ------------------------------------------------------------

          DELTA_GAUSS="0.000000"

          if [ -n "$PREVIOUS_GAUSS" ]; then
            DELTA_GAUSS=$(awk \
              -v current="$GAUSS" \
              -v previous="$PREVIOUS_GAUSS" \
              'BEGIN {
                printf "%.6f", current - previous
              }')
          fi

          echo
          echo "[DINAMICA]"
          echo "HISTORY_SOURCE=$HISTORY_SOURCE"
          echo "PREVIOUS_GAUSS=${PREVIOUS_GAUSS:-N/A}"
          echo "CURRENT_GAUSS=$GAUSS"
          echo "DELTA_GAUSS=$DELTA_GAUSS"

          # ============================================================
          # DECISION
          # ============================================================

          DECISION=$(awk \
            -v gauss="$GAUSS" \
            -v threshold="$MIN_GAUSS" \
            'BEGIN {
              if (gauss >= threshold)
                print "PASS"
              else
                print "FAIL"
            }')

          echo
          echo "[DECISION]"
          echo "UMBRAL=$MIN_GAUSS"
          echo "DECISION=$DECISION"

          # ============================================================
          # ACTUALIZAR HISTORIAL
          # ============================================================

          TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

          HISTORY_TMP="$RUNNER_TEMP/gauss-history.json.tmp"

          jq \
            --arg timestamp "$TIMESTAMP" \
            --arg run_id "$GITHUB_RUN_ID" \
            --arg run_number "$GITHUB_RUN_NUMBER" \
            --arg sha "$GITHUB_SHA" \
            --arg ref "$GITHUB_REF_NAME" \
            --arg gauss "$GAUSS" \
            --arg coverage "$COVERAGE" \
            --arg speed "$SPEED" \
            --arg avg_nanos "$AVG_NANOS" \
            --arg delta "$DELTA_GAUSS" \
            --arg decision "$DECISION" \
            --arg firma "$FIRMA" \
            --arg distance "$DISTANCE" \
            --arg angle_deg "$ANGLE_DEG" \
            --arg threshold "$MIN_GAUSS" \
            '
              .schema = 1
              |
              .entries = (
                (.entries // [])
                + [{
                    timestamp: $timestamp,
                    run_id: $run_id,
                    run_number: ($run_number | tonumber),
                    sha: $sha,
                    ref: $ref,
                    gauss: ($gauss | tonumber),
                    coverage: ($coverage | tonumber),
                    speed: ($speed | tonumber),
                    avg_nanos: ($avg_nanos | tonumber),
                    delta_gauss: ($delta | tonumber),
                    decision: $decision,
                    firma: $firma,
                    distance: ($distance | tonumber),
                    angle_deg: ($angle_deg | tonumber),
                    threshold: ($threshold | tonumber)
                  }]
              )
              |
              .entries = .entries[-100:]
            ' "$HISTORY_FILE" > "$HISTORY_TMP"

          mv "$HISTORY_TMP" "$HISTORY_FILE"

          echo
          echo "[HISTORIAL ACTUALIZADO]"
          echo "ENTRIES=$(jq '.entries | length' "$HISTORY_FILE")"
          echo "LATEST_GAUSS=$(jq -r '.entries[-1].gauss' "$HISTORY_FILE")"

